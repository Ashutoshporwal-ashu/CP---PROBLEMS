int longestIncreasingSubsequence (vector<int> &nums){
    int n = nums.size();

    vector<int> dp(n, 1);

    for(int i=1;i<n;i++){
        for(int j=i-1;j>=0;j--){
            if(nums[i] > nums[j]) dp[i] += dp[j];
        }
    }

    int sum = 0;

    for(int i=0;i<n;i++){
        sum += dp[i];
    }

    return sum;
}

